{
  "manifest_version": 3,
  "name": "Vimkit",
  "description": "Adds Vim-style keyboard navigation to Safari.",
  "version": "1.0.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "svim-scripts.js",
        "settings.js",
        "WebExtensionCommunicator.js",
        "command-dispatcher.js",
        "content-features.js",
        "keyboard-utils.js",
        "vimium-scripts.js",
        "link-hints.js",
        "injected.js"
      ],
      "css": ["injected.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Vimkit Settings",
    "default_icon": {
      "16": "images/toolbar-icon-16.png",
      "32": "images/toolbar-icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["defaultSettings.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "26.2"
    }
  }
}
